# ---------------------------------------------------------------------------
# Une seule adresse pour le site.
#
# Sans cette règle, www.trazicvalerie.fr et trazicvalerie.fr répondent toutes
# les deux : deux sites identiques aux yeux de Google, deux aperçus distincts
# pour Facebook. Celle-ci renvoie la forme « www » vers la forme courte —
# celle qu'utilisent les balises de partage de toutes les pages.
#
# Le passage en HTTPS est déjà assuré par Hostinger (option « Forcer le SSL »),
# il n'y a rien à ajouter ici pour lui.
# ---------------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On

  # %1 reprend ce qui suit « www. », la règle reste donc valable même si le
  # domaine change un jour.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>
