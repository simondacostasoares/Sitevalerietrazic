RewriteEngine On

# Ne s'applique qu'aux visiteurs arrivant via ventyoga.fr (http, https, www ou non)
RewriteCond %{HTTP_HOST} ^(www\.)?ventyoga\.fr$ [NC]

# Correspondances page par page
RewriteRule ^about/?$                          https://trazicvalerie.fr/a-propos.html [R=301,L]
RewriteRule ^yogatherapie/?$                   https://trazicvalerie.fr/yogatherapie.html [R=301,L]
RewriteRule ^yoga-adapt(é|%C3%A9)-sant(é|%C3%A9)/?$ https://trazicvalerie.fr/yoga-adapte-sante.html [R=301,L,NE]
RewriteRule ^copie-de-cours-enfants/?$         https://trazicvalerie.fr/cours-adultes.html [R=301,L]
RewriteRule ^copie-de-cours-adultes/?$         https://trazicvalerie.fr/cours-enfants.html [R=301,L]
RewriteRule ^copie-de-cours-enfants-1/?$       https://trazicvalerie.fr/cours-parents-enfants.html [R=301,L]

# Tout le reste (accueil, pages techniques Wix) -> accueil
RewriteCond %{HTTP_HOST} ^(www\.)?ventyoga\.fr$ [NC]
RewriteRule ^.*$                               https://trazicvalerie.fr/ [R=301,L]

# ---------------------------------------------------------------------------
# Une seule adresse pour le site.
#
# Sans cette règle, www.trazicvalerie.fr et trazicvalerie.fr répondent toutes
# les deux : deux sites identiques aux yeux de Google, deux aperçus distincts
# pour Facebook. Celle-ci renvoie la forme « www » vers la forme courte —
# celle qu'utilisent les balises de partage de toutes les pages.
#
# Le passage en HTTPS est déjà assuré par Hostinger (option « Forcer le SSL »),
# il n'y a rien à ajouter ici pour lui.
# ---------------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On

  # %1 reprend ce qui suit « www. », la règle reste donc valable même si le
  # domaine change un jour.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>
